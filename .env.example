# ── RExplain Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The backend loads this automatically on startup.

# Groq API key (required for LLM-powered RAG chat)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# PostgreSQL connection string (required for caching)
# Format: postgresql://user:password@host:port/dbname
# Render: set this via the service's "Environment" tab → link to your Postgres DB
# Railway: DATABASE_URL is injected automatically when you add a Postgres plugin
# AWS RDS: postgresql://user:pass@your-rds-endpoint.rds.amazonaws.com:5432/rexplain
DATABASE_URL=postgresql://user:password@localhost:5432/rexplain

# GitHub personal access token (optional, but recommended)
# Increases API rate limit from 60 → 5000 req/hour and enables private repo SHA checks
# Create one at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=
