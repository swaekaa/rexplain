    # ── RExplain Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The backend loads this automatically on startup.

# ── Azure OpenAI (required for LLM-powered RAG chat) ─────────────────────────
AZURE_OPENAI_API_KEY=your_azure_openai_key_here

# ── PostgreSQL connection string (required for caching + user accounts) ───────
# Format: postgresql://user:password@host:port/dbname
# Neon: copy the connection string from your Neon dashboard
DATABASE_URL=postgresql://user:password@localhost:5432/rexplain

# ── GitHub personal access token (optional, strongly recommended) ─────────────
# Increases API rate limit from 60 → 5000 req/hour
# Create one at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# ── HuggingFace token (required for embedding on Render; optional locally) ───
HF_API_TOKEN=

# ── Google OAuth (required for user accounts) ────────────────────────────────
# See GOOGLE_OAUTH_SETUP.md for step-by-step Google Cloud Console instructions
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── JWT secret (required for session tokens) ─────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# ── Frontend URL (required for OAuth redirect after login) ───────────────────
# Local development: http://localhost:3000
# Production:        https://rexplain.vercel.app (or your actual Vercel URL)
FRONTEND_URL=http://localhost:3000
